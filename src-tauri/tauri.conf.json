{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataQuery",
  "version": "0.2.2",
  "identifier": "dev.dataquery.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DataQuery",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        },
        "backgroundColor": "#1C1E22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A fast, safe desktop database client.",
    "copyright": "\u00a9 DataQuery contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4OTYwODRCN0UwMjY4QjIKUldTeWFBSitTd2lXT01NaDNiT25LU2paMXR3V2lsZHJYZ1NESVk0L3VmTFVtWVRZL0h3QUtwMisK",
      "endpoints": [
        "https://github.com/dev-manik-mia/DataQuery/releases/latest/download/latest.json"
      ]
    }
  }
}
